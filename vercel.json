{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/placement-subscription-reminders",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/admin/notes/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/placement-subscription-reminders/route.ts": {
      "maxDuration": 60
    }
  }
}

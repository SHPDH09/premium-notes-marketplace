  tagId     String @map("tag_id")

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     CrmTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("crm_contact_tags")
}

model CrmConversationTag {
  conversationId String @map("conversation_id")
  tagId          String @map("tag_id")

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          CrmTag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("crm_conversation_tags")
}

model CrmCallRecord {
  id             String             @id @default(cuid())
  companyId      String             @map("company_id")
  conversationId String?            @map("conversation_id")
  providerCallId String?            @map("provider_call_id")
  direction      CrmCallDirection
  status         CrmCallRecordStatus
  callerJid      String?            @map("caller_jid")
  chatJid        String?            @map("chat_jid")
  durationSec    Int?               @map("duration_sec")
  internalNotes  String?            @map("internal_notes") @db.Text
  outcome        String?
  startedAt      DateTime           @default(now()) @map("started_at")
  endedAt        DateTime?          @map("ended_at")

  company      CrmCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation CrmConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([companyId, startedAt])
  @@map("crm_call_records")
}

model CrmAutomationRule {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  name            String
  ruleType        String   @map("rule_type")
  triggerType     String   @default("message.received") @map("trigger_type")
  enabled         Boolean  @default(true)
  testMode        Boolean  @default(false) @map("test_mode")
  priority        Int      @default(100)
  config          Json
  lastExecutedAt  DateTime? @map("last_executed_at")
  successCount    Int      @default(0) @map("success_count")
  failureCount    Int      @default(0) @map("failure_count")
  createdByMemberId String? @map("created_by_member_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company    CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executions CrmAutomationExecution[]

  @@index([companyId, enabled, priority])
  @@map("crm_automation_rules")
}

model CrmAutomationExecution {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  ruleId         String   @map("rule_id")
  triggerType    String   @map("trigger_type")
  triggerEventId String?  @map("trigger_event_id")
  conversationId String?  @map("conversation_id")
  contactId      String?  @map("contact_id")
  status         String   @default("running")
  conditionsMet  Boolean? @map("conditions_met")
  error          String?  @db.Text
  startedAt      DateTime @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  company      CrmCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule         CrmAutomationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  steps        CrmAutomationExecutionStep[]

  @@index([companyId, startedAt])
  @@index([ruleId, startedAt])
  @@map("crm_automation_executions")
}

model CrmAutomationExecutionStep {
  id           String   @id @default(cuid())
  executionId  String   @map("execution_id")
  actionType   String   @map("action_type")
  status       String   @default("pending")
  detail       Json?
  error        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  execution CrmAutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("crm_automation_execution_steps")
}

model CrmScheduledTask {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  taskType       String   @map("task_type")
  conversationId String?  @map("conversation_id")
  ruleId         String?  @map("rule_id")
  payload        Json?
  runAt          DateTime @map("run_at")
  status         String   @default("pending")
  attempts       Int      @default(0)
  lastError      String?  @map("last_error") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([companyId, conversationId])
  @@map("crm_scheduled_tasks")
}

model CrmAiReplySettings {
  id                String   @id @default(cuid())
  companyId         String   @unique @map("company_id")
  enabled           Boolean  @default(false)
  mode              String   @default("suggest")
  model             String   @default("gpt-4o-mini")
  maxTokens         Int      @default(400) @map("max_tokens")
  knowledgeBaseText String?  @map("knowledge_base_text") @db.Text
  autoReplyEnabled  Boolean  @default(false) @map("auto_reply_enabled")
  escalateKeywords  String?  @map("escalate_keywords") @db.Text
  updatedAt         DateTime @updatedAt @map("updated_at")

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("crm_ai_reply_settings")
}

model CrmCampaign {
  id          String            @id @default(cuid())
  companyId   String            @map("company_id")
  name        String
  status      CrmCampaignStatus @default(DRAFT)
  templateBody String?          @map("template_body") @db.Text
  scheduledAt DateTime?         @map("scheduled_at")
  stats       Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  company    CrmCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipients CrmCampaignRecipient[]

  @@index([companyId, status])
  @@map("crm_campaigns")
}

model CrmCampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  phone      String
  status     String   @default("pending")
  error      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  campaign CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@map("crm_campaign_recipients")
}

model CrmUsageRecord {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  messagesIn  Int      @default(0) @map("messages_in")
  messagesOut Int      @default(0) @map("messages_out")
  createdAt   DateTime @default(now()) @map("created_at")

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodStart])
  @@map("crm_usage_records")
}

model CrmWebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("walayer")
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  sessionId   String?  @map("session_id")
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime? @map("processed_at")
  error       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([processed, createdAt])
  @@map("crm_webhook_events")
}

model CrmNotification {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  type      String
  title     String
  body      String?  @db.Text
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  member CrmCompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt])
  @@map("crm_notifications")
}

model CrmAuditLog {
  id        String   @id @default(cuid())
  companyId String?  @map("company_id")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  company CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("crm_audit_logs")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  entity     String
  entityId   String   @map("entity_id")
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

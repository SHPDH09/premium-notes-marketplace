generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum NoteStatus {
  ACTIVE
  DISABLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  DISABLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum CollaboratorType {
  COMPANY
  COLLEGE
  INSTITUTE
}

enum PublishStatus {
  ACTIVE
  DISABLED
}

enum PopupType {
  TEXT
  IMAGE
}

enum PopupRepeatMode {
  REPEAT
  ONCE_PER_SESSION
  ONCE_PER_BROWSER
}

enum CouponAppliesTo {
  NOTE
  PHYSICAL
  BOTH
}

enum PaperSize {
  A4
  A5
  OTHER
}

enum PaperType {
  NORMAL
  PREMIUM
}

enum PrintType {
  BLACK_WHITE
  COLOR
}

enum BindingType {
  NONE
  SPIRAL
  SOFT_BINDING
  HARD_BINDING
}

enum PhysicalFulfillmentStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  PRINTING
  QUALITY_CHECK
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PhysicalPrintStatus {
  PENDING_PRINT
  PRINTING
  PRINTED
  QC_PENDING
  QC_PASSED
  QC_FAILED
  REPRINT_REQUIRED
}

enum PhysicalShippingStatus {
  NOT_SHIPPED
  READY_FOR_PACKING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum PhysicalRefundStatus {
  NOT_REQUESTED
  REQUESTED
  APPROVED
  PROCESSING
  REFUNDED
  REJECTED
}

enum JobApplyType {
  EMAIL
  LINK
  WALK_IN
  CALL
  WHATSAPP
}

enum JobApplicationChannel {
  EMAIL_GMAIL
  EMAIL_MAILTO
  EXTERNAL_LINK
  WALK_IN
  CALL
  WHATSAPP
}

enum PlacementSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum JobPostingSource {
  ADMIN
  STUDENT
}

enum JobReviewStatus {
  NONE
  PENDING
  APPROVED
  VERIFIED
  REJECTED
}

enum CrmCompanyStatus {
  ACTIVE
  SUSPENDED
}

enum CrmMemberRole {
  COMPANY_ADMIN
  AGENT
  SUPERVISOR
}

enum CrmAgentAvailability {
  ONLINE
  BUSY
  OFFLINE
}

enum CrmWaConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  ERROR
}

enum CrmConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum CrmConversationPriority {
  NORMAL
  HIGH
  URGENT
}

enum CrmMessageDirection {
  INBOUND
  OUTBOUND
}

enum CrmSendMethod {
  MANUAL
  AUTOMATION
  CHATBOT
  API
  EXTERNAL
}

enum CrmMessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
}

enum CrmCallDirection {
  INBOUND
  OUTBOUND
}

enum CrmCallRecordStatus {
  RINGING
  ANSWERED
  REJECTED
  MISSED
  FAILED
}

enum CrmCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum CrmCampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  OPTED_OUT
}

enum CrmTemplateApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  UNKNOWN
}

enum CrmConsentType {
  MARKETING
  TRANSACTIONAL
}

enum CrmContactStatus {
  ACTIVE
  ARCHIVED
  DO_NOT_CONTACT
}

enum CrmBillingInterval {
  MONTHLY
  YEARLY
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String     @map("password_hash")
  role          Role       @default(STUDENT)
  profileImage  String?    @map("profile_image")
  status          UserStatus @default(ACTIVE)
  sessionVersion  Int        @default(0) @map("session_version")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  cartItems          CartItem[]
  cartMeta           CartMeta?
  orders             Order[]
  transactions       Transaction[]
  purchases          Purchase[]
  couponRedemptions         CouponRedemption[]
  physicalCouponRedemptions PhysicalCouponRedemption[]
  adminProfile              AdminProfile?
  studentSpotlight          StudentSpotlight?
  addresses                 UserAddress[]
  physicalCartItems         PhysicalCartItem[]
  physicalCartMeta          PhysicalCartMeta?
  physicalOrders            PhysicalOrder[]
  careerProfile             StudentCareerProfile?
  placementSubscriptions    UserPlacementSubscription[]
  placementPlanOrders       PlacementPlanOrder[]
  placedStudentProfile      PlacedStudent?
  jobApplications           JobApplication[]
  submittedJobPostings      JobPosting[] @relation("JobSubmittedBy")
  crmCompanyMembers         CrmCompanyMember[]

  @@map("users")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

model Note {
  id            String       @id @default(cuid())
  name          String
  coverImage    String?      @map("cover_image")
  title         String
  description   String       @db.Text
  pdfStorageKey        String? @map("pdf_storage_key")
  pdfPreviewStorageKey String? @map("pdf_preview_storage_key")
  freePreviewPages     Int     @default(2) @map("free_preview_pages")
  pdfPageCount         Int?    @map("pdf_page_count")
  notesLink            String? @map("notes_link")
  price         Decimal      @db.Decimal(10, 2)
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal      @default(0) @map("discount_value") @db.Decimal(10, 2)
  finalPrice    Decimal      @map("final_price") @db.Decimal(10, 2)
  status        NoteStatus   @default(ACTIVE)
  purchaseCount Int          @default(0) @map("purchase_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  cartItems    CartItem[]
  orderItems   OrderItem[]
  purchases    Purchase[]
  couponNotes         CouponNote[]
  physicalDocuments   PhysicalDocument[]

  @@index([status])
  @@index([createdAt])
  @@map("notes")
}

model Coupon {
  id                  String         @id @default(cuid())
  code                String         @unique
  discountType        DiscountType   @map("discount_type")
  discountValue       Decimal        @map("discount_value") @db.Decimal(10, 2)
  maxUsers            Int?           @map("max_users")
  usedCount           Int            @default(0) @map("used_count")
  validFrom           DateTime       @map("valid_from")
  validUntil          DateTime       @map("valid_until")
  minPurchaseAmount   Decimal        @default(0) @map("min_purchase_amount") @db.Decimal(10, 2)
  maxDiscount         Decimal?       @map("max_discount") @db.Decimal(10, 2)
  status              CouponStatus   @default(ACTIVE)
  appliesTo           CouponAppliesTo @default(NOTE) @map("applies_to")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  couponNotes              CouponNote[]
  couponPhysicalDocuments  CouponPhysicalDocument[]
  orders                   Order[]
  redemptions              CouponRedemption[]
  physicalOrders           PhysicalOrder[]
  physicalRedemptions      PhysicalCouponRedemption[]

  @@map("coupons")
}

model CouponNote {
  couponId String @map("coupon_id")
  noteId   String @map("note_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([couponId, noteId])
  @@map("coupon_notes")
}

model CouponPhysicalDocument {
  couponId            String @map("coupon_id")
  physicalDocumentId  String @map("physical_document_id")
  coupon              Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  physicalDocument    PhysicalDocument @relation(fields: [physicalDocumentId], references: [id], onDelete: Cascade)

  @@id([couponId, physicalDocumentId])
  @@map("coupon_physical_documents")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  couponId  String   @map("coupon_id")
  orderId   String   @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@map("coupon_redemptions")
}

model CartMeta {
  userId     String  @id @map("user_id")
  couponCode String? @map("coupon_code")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart_meta")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  subtotal          Decimal           @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  couponDiscount    Decimal           @default(0) @map("coupon_discount") @db.Decimal(10, 2)
  totalAmount       Decimal           @map("total_amount") @db.Decimal(10, 2)
  couponId          String?           @map("coupon_id")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  transactionStatus TransactionStatus @default(PENDING) @map("transaction_status")
  cashfreeOrderId   String?           @unique @map("cashfree_order_id")
  adminNote         String?           @map("admin_note") @db.Text
  refundReason      String?           @map("refund_reason") @db.Text
  refundedAmount    Decimal           @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon      Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  transaction Transaction?
  purchases   Purchase[]
  redemption  CouponRedemption?
  refunds     OrderRefund[]

  @@index([userId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String  @map("order_id")
  noteId     String  @map("note_id")
  price      Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  finalPrice Decimal @map("final_price") @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note  Note  @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model OrderRefund {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  amount    Decimal  @db.Decimal(10, 2)
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_refunds")
}

model Transaction {
  id              String        @id @default(cuid())
  orderId         String        @unique @map("order_id")
  userId          String        @map("user_id")
  transactionId   String        @unique @map("transaction_id")
  amount          Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @map("payment_status")
  paymentMethod   String        @default("cashfree") @map("payment_method")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  noteId          String   @map("note_id")
  orderId         String   @map("order_id")
  purchasedPrice  Decimal  @map("purchased_price") @db.Decimal(10, 2)
  purchasedAt     DateTime @default(now()) @map("purchased_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note  Note  @relation(fields: [noteId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId])
  @@map("purchases")
}

model Collaborator {
  id          String           @id @default(cuid())
  name        String
  type        CollaboratorType
  logoImage   String?          @map("logo_image")
  website     String?
  description String?          @db.Text
  status      PublishStatus    @default(ACTIVE)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([type])
  @@map("collaborators")
}

model SitePopup {
  id              String           @id @default(cuid())
  name            String
  popupType       PopupType        @map("popup_type")
  title           String?
  bodyText        String?          @map("body_text") @db.Text
  imageStorageKey String?          @map("image_storage_key")
  buttonLabel     String?          @map("button_label")
  buttonUrl       String?          @map("button_url")
  whatsappUrl     String?          @map("whatsapp_url")
  socialLinks     Json             @default("[]") @map("social_links")
  targetPages     Json             @default("[]") @map("target_pages")
  validFrom       DateTime?        @map("valid_from")
  validUntil      DateTime?        @map("valid_until")
  repeatMode      PopupRepeatMode  @default(REPEAT) @map("repeat_mode")
  sortOrder       Int              @default(0) @map("sort_order")
  status          PublishStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("site_popups")
}

model StudentSpotlight {
  id          String        @id @default(cuid())
  userId      String?       @unique @map("user_id")
  displayName String        @map("display_name")
  institute   String?
  headline    String?
  quote       String?       @db.Text
  photo       String?
  status      PublishStatus @default(ACTIVE)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("student_spotlights")
}

model ShippingSettings {
  id                    String   @id @default("default")
  deliveryCharge        Decimal  @default(50) @map("delivery_charge") @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal? @map("free_delivery_threshold") @db.Decimal(10, 2)
  processingDays        Int      @default(2) @map("processing_days")
  shippingDays          Int      @default(3) @map("shipping_days")
  shippingEnabled       Boolean  @default(true) @map("shipping_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shipping_settings")
}

model PhysicalDocument {
  id               String        @id @default(cuid())
  sourceNoteId     String?       @map("source_note_id")
  name             String
  title            String
  description      String        @db.Text
  coverStorageKey  String?       @map("cover_storage_key")
  sourcePdfKey     String?       @map("source_pdf_key")
  pageCount        Int?          @map("page_count")
  paperSize        PaperSize     @default(A4) @map("paper_size")
  paperType        PaperType     @default(NORMAL) @map("paper_type")
  printType        PrintType     @default(BLACK_WHITE) @map("print_type")
  bindingType      BindingType   @default(NONE) @map("binding_type")
  printingCost     Decimal       @default(0) @map("printing_cost") @db.Decimal(10, 2)
  bindingCost      Decimal       @default(0) @map("binding_cost") @db.Decimal(10, 2)
  packagingCost    Decimal       @default(0) @map("packaging_cost") @db.Decimal(10, 2)
  basePrice        Decimal       @default(0) @map("base_price") @db.Decimal(10, 2)
  finalPrice       Decimal       @map("final_price") @db.Decimal(10, 2)
  priceOverride    Boolean       @default(false) @map("price_override")
  minQuantity      Int           @default(1) @map("min_quantity")
  maxQuantity      Int           @default(10) @map("max_quantity")
  processingDays   Int           @default(2) @map("processing_days")
  status           PublishStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  sourceNote      Note?                    @relation(fields: [sourceNoteId], references: [id], onDelete: SetNull)
  cartItems       PhysicalCartItem[]
  orderItems      PhysicalOrderItem[]
  couponDocuments CouponPhysicalDocument[]

  @@index([status])
  @@map("physical_documents")
}

model PhysicalCartMeta {
  userId     String  @id @map("user_id")
  couponCode String? @map("coupon_code")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("physical_cart_meta")
}

model PhysicalCartItem {
  id                 String      @id @default(cuid())
  userId             String      @map("user_id")
  physicalDocumentId String      @map("physical_document_id")
  quantity           Int         @default(1)
  printType          PrintType   @map("print_type")
  paperType          PaperType   @map("paper_type")
  bindingType        BindingType @map("binding_type")
  unitPrice          Decimal     @map("unit_price") @db.Decimal(10, 2)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  physicalDocument PhysicalDocument @relation(fields: [physicalDocumentId], references: [id], onDelete: Cascade)

  @@unique([userId, physicalDocumentId, printType, paperType, bindingType])
  @@map("physical_cart_items")
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  fullName     String   @map("full_name")
  phone        String
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model PhysicalOrder {
  id                 String                    @id @default(cuid())
  orderNumber        String                    @unique @map("order_number")
  userId             String                    @map("user_id")
  subtotal           Decimal                   @db.Decimal(10, 2)
  discountAmount     Decimal                   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponDiscount     Decimal                   @default(0) @map("coupon_discount") @db.Decimal(10, 2)
  deliveryCharge     Decimal                   @default(0) @map("delivery_charge") @db.Decimal(10, 2)
  totalAmount        Decimal                   @map("total_amount") @db.Decimal(10, 2)
  couponId           String?                   @map("coupon_id")
  paymentStatus      PaymentStatus             @default(PENDING) @map("payment_status")
  fulfillmentStatus  PhysicalFulfillmentStatus @default(ORDER_PLACED) @map("fulfillment_status")
  printStatus        PhysicalPrintStatus       @default(PENDING_PRINT) @map("print_status")
  shippingStatus     PhysicalShippingStatus    @default(NOT_SHIPPED) @map("shipping_status")
  refundStatus       PhysicalRefundStatus      @default(NOT_REQUESTED) @map("refund_status")
  cashfreeOrderId    String?                   @unique @map("cashfree_order_id")
  paymentTxnId       String?                   @map("payment_txn_id")
  idempotencyKey     String?                   @unique @map("idempotency_key")
  expectedDelivery   DateTime?                 @map("expected_delivery")
  courierName        String?                   @map("courier_name")
  trackingNumber     String?                   @map("tracking_number")
  trackingUrl        String?                   @map("tracking_url")
  shippingDate       DateTime?                 @map("shipping_date")
  deliveredAt        DateTime?                 @map("delivered_at")
  packageWeight      String?                   @map("package_weight")
  packageDimensions  String?                   @map("package_dimensions")
  packageCount       Int?                      @map("package_count")
  packagingNotes     String?                   @map("packaging_notes") @db.Text
  qcFailureReason    String?                   @map("qc_failure_reason") @db.Text
  cancelReason       String?                   @map("cancel_reason") @db.Text
  studentNameSnap    String                    @map("student_name_snap")
  studentEmailSnap   String                    @map("student_email_snap")
  studentPhoneSnap   String?                   @map("student_phone_snap")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon      Coupon?                      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       PhysicalOrderItem[]
  address     PhysicalOrderAddress?
  history     PhysicalOrderStatusHistory[]
  printingJob PrintingJob?
  shipment    Shipment?
  refunds     PhysicalOrderRefund[]
  redemption  PhysicalCouponRedemption?

  @@index([userId])
  @@index([createdAt])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@map("physical_orders")
}

model PhysicalOrderItem {
  id                 String      @id @default(cuid())
  orderId            String      @map("order_id")
  physicalDocumentId String?     @map("physical_document_id")
  documentNameSnap   String      @map("document_name_snap")
  documentTitleSnap  String      @map("document_title_snap")
  quantity           Int
  pageCountSnap      Int?          @map("page_count_snap")
  printType          PrintType     @map("print_type")
  paperType          PaperType     @map("paper_type")
  bindingType        BindingType   @map("binding_type")
  unitPrice          Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal       @map("total_price") @db.Decimal(10, 2)
  createdAt          DateTime      @default(now()) @map("created_at")

  order            PhysicalOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  physicalDocument PhysicalDocument? @relation(fields: [physicalDocumentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("physical_order_items")
}

model PhysicalOrderAddress {
  id           String   @id @default(cuid())
  orderId      String   @unique @map("order_id")
  fullName     String   @map("full_name")
  phone        String
  altPhone     String?  @map("alt_phone")
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  landmark     String?
  city         String
  state        String

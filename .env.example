# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# NextAuth / session encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=replace_with_long_random_secret

# Public app URL (Vercel production domain)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Branding (safe for frontend)
NEXT_PUBLIC_BRAND_NAME=TechLaunchpad
NEXT_PUBLIC_BRAND_LOGO_TEXT=TL
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Admin seed (run npm run db:seed locally / in CI — never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=Platform Admin

# S3-compatible storage (e.g. Supabase Storage S3 endpoint)
STORAGE_URL=https://your-project.storage.supabase.co/storage/v1/s3
STORAGE_KEY=your_storage_access_key
STORAGE_SECRET=your_storage_secret_key
STORAGE_BUCKET=notes-platform
STORAGE_REGION=auto
# Optional public CDN/base for cover images
STORAGE_PUBLIC_URL=

# Cashfree Payments
PAYMENT_API_KEY=your_cashfree_app_id
PAYMENT_SECRET=your_cashfree_secret_key
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Dev only: auto-complete checkout without gateway (never enable in production)
ALLOW_DEV_PAYMENT=false

# Vercel CLI deploy token (local/CI only — set in Vercel dashboard secrets, not in repo)
VERCEL_TOKEN=your_vercel_token

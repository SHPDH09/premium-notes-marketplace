# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# NextAuth / session encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=replace_with_long_random_secret

# Fallback when host cannot be detected; per-request host is used on Vercel for www vs apex
NEXTAUTH_URL=https://www.techlaunchpad.in
# Optional: trust forwarded host outside Vercel
AUTH_TRUST_HOST=true

# App URL for auth callbacks / redirects (can be your Vercel *.vercel.app URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Branding (safe for frontend)
# Shown on invoices & public copy — use your real domain, not the Vercel default URL
NEXT_PUBLIC_BRAND_WEBSITE=https://www.techlaunchpad.in
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8XYSRC1FuCSJXgwb21
NEXT_PUBLIC_BRAND_NAME=TechLaunchpad
NEXT_PUBLIC_BRAND_LOGO_TEXT=TL
NEXT_PUBLIC_SUPPORT_EMAIL=quantronsoft@gmail.com

# Platform emails (subscription reminders) — Gmail app password recommended
PLATFORM_SMTP_EMAIL=
PLATFORM_SMTP_APP_PASSWORD=
# PLATFORM_SMTP_HOST=smtp.gmail.com
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_FROM_NAME=TechLaunchpad

# Vercel Cron auth (generate: openssl rand -base64 32)
CRON_SECRET=

# WhatsApp Channel auto-post (optional — Admin → WhatsApp Channel; API key encrypted in DB)
# Provider: Wapito — https://wapito.com/docs/getting-started/ (token wpt_…, channel …@newsletter)

# Admin seed (run npm run db:seed locally / in CI — never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=Platform Admin

# S3-compatible storage (e.g. Supabase Storage S3 endpoint)
STORAGE_URL=https://your-project.storage.supabase.co/storage/v1/s3
STORAGE_KEY=your_storage_access_key
STORAGE_SECRET=your_storage_secret_key
STORAGE_BUCKET=notes-platform
STORAGE_REGION=auto
# Optional public CDN/base for cover images
STORAGE_PUBLIC_URL=

# Cashfree Payments
PAYMENT_API_KEY=your_cashfree_app_id
PAYMENT_SECRET=your_cashfree_secret_key
PAYMENT_MERCHANT_LABEL=TechLaunchpad
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Placement — AI application emails (set in Vercel Production env)
# Placement AI (resume summary + application emails). OPENAI_API_KEY also works as fallback.
PLACEMENT_OPENAI_API_KEY=
PLACEMENT_OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Dev only: auto-complete checkout without gateway (never enable in production)
ALLOW_DEV_PAYMENT=false

# Vercel CLI deploy token (local/CI only — set in Vercel dashboard secrets, not in repo)
VERCEL_TOKEN=your_vercel_token
